DISCORD_TOKEN=paste-bot-token-here

# LLM backend: "ollama" (local qwen) or "gemini"/"openai" (OpenAI-compatible proxy)
LLM_BACKEND=ollama

# ollama backend
OLLAMA_URL=http://127.0.0.1:11434

# openai/gemini backend (e.g. local cli-proxy-api serving Gemini)
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_API_KEY=sk-...

# model name for the selected backend (e.g. qwen3:8b, or gemini-3-flash)
LLM_MODEL=qwen3:8b

# image model via the same proxy (Gemini "nano banana"); used by !obraz / "narysuj"
IMAGE_MODEL=gemini-3.1-flash-image

WAKE_WORD=bot
DIALOG_TIMEOUT=20
PERSONA_PATH=persona.md
VOICEPRINT_DIR=voiceprint

# White Rabbit (project mgmt) — bot logs in as a real user (no token auth).
# The account must be is_staff or a member of the projects it should see.
WR_BASE_URL=
WR_USERNAME=
WR_PASSWORD=
# path to a local clone of the codebase for "which module handles X" answers
CODE_REPO_PATH=
